{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/cliqueaqui/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/mmvdidis/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mmvdidis/:path*",
      "destination": "https://mmv-didis.vercel.app/:path*"
    }
  ]
}
